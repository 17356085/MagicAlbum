APP_AUTH_VERIFY_MODE=turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_EXPECTED_HOSTNAME=localhost
APP_AUTH_OAUTH_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/oauth/callback
APP_AUTH_OAUTH_STATE_TTL_SECONDS=300
GITHUB_OAUTH_CLIENT_ID=your_github_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_client_secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/callback/github
GITHUB_OAUTH_SCOPE=read:user user:email
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/callback/google
GOOGLE_OAUTH_SCOPE=openid email profile
APPLE_OAUTH_CLIENT_ID=your_apple_services_id
APPLE_OAUTH_TEAM_ID=your_apple_team_id
APPLE_OAUTH_KEY_ID=your_apple_key_id
APPLE_OAUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----
APPLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/auth/oauth/callback/apple
APPLE_OAUTH_SCOPE=name email
APPLE_OAUTH_CLIENT_SECRET_TTL_SECONDS=15768000
WECHAT_OAUTH_APP_ID=your_wechat_app_id
WECHAT_OAUTH_APP_SECRET=your_wechat_app_secret
WECHAT_OAUTH_REDIRECT_URI=https://your-public-domain.example.com/api/v1/auth/oauth/callback/wechat
WECHAT_OAUTH_SCOPE=snsapi_login
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_APP_CLIENT_ID=your_cognito_app_client_id
COGNITO_APP_CLIENT_SECRET=your_cognito_app_client_secret
COGNITO_EMAIL_OTP_EXPIRE_SECONDS=300
COGNITO_SEND_COOLDOWN_SECONDS=60
