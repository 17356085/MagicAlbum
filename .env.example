# Optional full-Compose local run: copy to .env and fill every empty required value.
# Keep .env private. Use different strong random secrets; this is not a public deployment template.
DB_NAME=MagicAlbum
NOTIFICATION_DB_NAME=MagicAlbum_notifications
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Set both account pairs with distinct accounts and generated credentials.
# Existing volumes require the explicit initialization step in the README before switching.
NOTIFICATION_DB_USER=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_DB_MIGRATION_USER=
NOTIFICATION_DB_MIGRATION_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
JWT_ISSUER=MagicAlbum
JWT_SECRET=
# First boot: leave email empty and user id zero. Select an existing user id after trusted login/read-back.
# An email-only selector requires a verified email; with a user id, email is an optional consistency check.
APP_ADMIN_EMAIL=
APP_ADMIN_USER_ID=0
INTERNAL_SERVICE_TOKEN=
# Used by the opt-in independent chat service for private core contracts; keep it
# distinct from INTERNAL_SERVICE_TOKEN and any notification/media credential.
CHAT_INTERNAL_SERVICE_TOKEN=
CHAT_GOVERNANCE_INTERNAL_TOKEN=

# Optional independent chat topology (docker-compose.chat.yml). Leave these
# unset for the default single-core Compose deployment.
CHAT_DB_NAME=bluealbum_chat
CHAT_DB_URL=
CHAT_DB_USER=
CHAT_DB_PASSWORD=
CHAT_DB_MIGRATION_USER=
CHAT_DB_MIGRATION_PASSWORD=
CHAT_DB_ROOT_PASSWORD=
CHAT_CORE_URL=http://backend:8080
# The chat Compose overlay sets this internally; leave blank for core-only Compose.
CHAT_SERVICE_GATEWAY_URI=

# Optional M3 extension: use docker-compose.media.yml; keep this token distinct from INTERNAL_SERVICE_TOKEN.
MEDIA_INTERNAL_SERVICE_TOKEN=
# amqp://<percent-encoded-user>:<percent-encoded-password>@rabbitmq:5672/
MEDIA_AMQP_URL=
# Optional S3-compatible provider. Leave all unset to keep local storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
