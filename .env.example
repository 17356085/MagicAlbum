# Optional full-Compose local run: copy to .env and fill every empty required value.
# Keep .env private. Use different strong random secrets; this is not a public deployment template.
DB_NAME=MagicAlbum
NOTIFICATION_DB_NAME=MagicAlbum_notifications
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
JWT_ISSUER=MagicAlbum
JWT_SECRET=
# First boot: leave empty. After registering an account, set its existing email and restart backend.
APP_ADMIN_EMAIL=
INTERNAL_SERVICE_TOKEN=
