# Optional full-Compose local run: copy to .env and fill every empty required value.
# Keep .env private. Use different strong random secrets; this is not a public deployment template.
DB_NAME=MagicAlbum
NOTIFICATION_DB_NAME=MagicAlbum_notifications
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
JWT_ISSUER=MagicAlbum
JWT_SECRET=
# First boot: leave empty. After registering an account, set its existing email and restart backend.
APP_ADMIN_EMAIL=
INTERNAL_SERVICE_TOKEN=

# Optional M3 extension: use docker-compose.media.yml; keep this token distinct from INTERNAL_SERVICE_TOKEN.
MEDIA_INTERNAL_SERVICE_TOKEN=
# amqp://<percent-encoded-user>:<percent-encoded-password>@rabbitmq:5672/
MEDIA_AMQP_URL=
# Optional S3-compatible provider. Leave all unset to keep local storage.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
