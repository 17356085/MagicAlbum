VITE_API_BASE_URL=http://localhost:9000/api/v1
VITE_USE_API_MOCK=false
VITE_AUTH_VERIFY_MODE=turnstile
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
VITE_AUTH_OAUTH_GITHUB_ENABLED=true
VITE_AUTH_OAUTH_GOOGLE_ENABLED=false
VITE_AUTH_OAUTH_APPLE_ENABLED=false
VITE_AUTH_OAUTH_WECHAT_ENABLED=false
# 默认会回退到 ${VITE_API_BASE_URL}/auth/oauth/authorize?provider=<provider>
# 也可以在这里覆盖成完整授权地址
VITE_AUTH_OAUTH_GITHUB_AUTHORIZE_URL=
VITE_AUTH_OAUTH_GOOGLE_AUTHORIZE_URL=
VITE_AUTH_OAUTH_APPLE_AUTHORIZE_URL=
VITE_AUTH_OAUTH_WECHAT_AUTHORIZE_URL=
