{
  "name": "bluealbum-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "vite build && node scripts/check-initial-load.mjs",
    "lint": "eslint . --max-warnings=0",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "make:favicon": "node scripts/make-favicon.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "axios": "1.20.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "katex": "0.18.2",
    "markdown-it": "^14.3.3",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vue": "3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.2.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^3.0.2",
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.4",
    "vitest": "4.1.12",
    "vue-tsc": "^2.2.12"
  }
}
